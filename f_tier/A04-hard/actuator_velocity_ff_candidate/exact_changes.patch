+"""Single held joint-velocity feedforward for original position servos.
+
+No simulator imports, new gains, velocity clipping or joint-state mutations.
+The held target is calculated ONCE per successful control solve, never in apply.
+"""
+import numpy as np
+
+
+def prepare_held(qik,actual_q,dt,kp,kv,control_time):
+    qik=np.asarray(qik,dtype=float).copy();actual=np.asarray(actual_q,dtype=float).copy()
+    kp=np.asarray(kp,dtype=float);kv=np.asarray(kv,dtype=float)
+    if not(dt>0 and np.isfinite(dt)and np.all(kp>0)and np.all(kv>=0)):
+        raise ValueError('Invalid original position-servo coefficients/control dt')
+    if not(qik.shape==actual.shape==kp.shape==kv.shape and np.isfinite(np.r_[qik,actual,kp,kv]).all()):
+        raise ValueError('Invalid held velocity-feedforward input')
+    qdot=(qik-actual)/dt
+    ff_offset=(kv/kp)*qdot
+    if not np.isfinite(np.r_[qdot,ff_offset,qik+ff_offset]).all():
+        raise ValueError('Nonfinite desired velocity/held actuation target')
+    return dict(control_time=float(control_time),dt=float(dt),qIK=qik,actual_q_at_control=actual,
+                desired_joint_velocity=qdot,velocity_ff_torque=kv*qdot,
+                ff_position_offset=ff_offset,actuation_nominal=qik+ff_offset)
+
+
+def apply_held(controller,original_apply,held):
+    """Reuse original gravity/passive compensation and all original clipping.
+
+    The temporary actuation nominal never enters self.q or later IK seeds.
+    Current physics-step q/qdot is read for reporting only, not to recompute FF.
+    """
+    n=len(controller.qa);m=controller.m;d=controller.d
+    nominal_before=controller.nominal.copy();qik_before=controller.q.copy()
+    q_actual_before=d.qpos[controller.qa].copy();v_actual_before=d.qvel[controller.va].copy()
+    force_before=d.actuator_force[:n].copy()
+    joint_force_before=d.qfrc_actuator[controller.va].copy()
+    controller.nominal=held['actuation_nominal'].copy()
+    try:
+        original_apply()
+        # Original apply has just computed this scratch residual. No new FK,
+        # force evaluation or other native call is introduced here.
+        residual=(controller.s.qfrc_bias-controller.s.qfrc_passive)[controller.va].copy()
+        kp=m.actuator_gainprm[:n,0];ctrlrange=m.actuator_ctrlrange[:n].copy()
+        base=held['qIK']+residual/kp
+        with_ff=held['actuation_nominal']+residual/kp
+        clipped=d.ctrl[:n].copy()
+        record=dict(native_s=float(d.time),control_time=held['control_time'],held_control_dt=held['dt'],
+            qIK=held['qIK'].tolist(),actual_q_at_control=held['actual_q_at_control'].tolist(),
+            desired_joint_velocity=held['desired_joint_velocity'].tolist(),
+            velocity_ff_torque=held['velocity_ff_torque'].tolist(),
+            held_ff_position_offset=held['ff_position_offset'].tolist(),held_actuation_nominal=held['actuation_nominal'].tolist(),
+            original_residual_compensation_torque=residual.tolist(),
+            no_ff_unclipped_ctrl=base.tolist(),with_ff_unclipped_ctrl=with_ff.tolist(),actual_final_clipped_ctrl=clipped.tolist(),
+            ctrl_clip_delta=(clipped-with_ff).tolist(),control_limit_saturated=((with_ff<ctrlrange[:,0])|(with_ff>ctrlrange[:,1])).tolist(),
+            held_nominal_outside_physical_joint_range=((held['actuation_nominal']<m.jnt_range[controller.j,0])|(held['actuation_nominal']>m.jnt_range[controller.j,1])).tolist(),
+            ctrl_range=ctrlrange.tolist(),actuator_force_limited=m.actuator_forcelimited[:n].astype(bool).tolist(),actuator_force_range=m.actuator_forcerange[:n].tolist(),
+            joint_actuator_force_limited=m.jnt_actfrclimited[controller.j].astype(bool).tolist(),joint_actuator_force_range=m.jnt_actfrcrange[controller.j].tolist(),
+            physical_joint_range=m.jnt_range[controller.j].tolist(),IK_buffered_joint_range=np.c_[controller.lo,controller.hi].tolist(),
+            actual_q_at_apply=q_actual_before.tolist(),actual_qdot_at_apply=v_actual_before.tolist(),
+            actual_actuator_force_before_new_ctrl_evaluation=force_before.tolist(),
+            actual_joint_actuation_force_before_new_ctrl_evaluation=joint_force_before.tolist(),
+            force_observation_scope='Existing actuator_force at apply entry; not recomputed new-command torque or a claimed current clipping event.',
+            ff_recomputed_in_apply=False)
+        return record
+    finally:
+        controller.nominal=nominal_before
+        if not np.array_equal(controller.q,qik_before)or not np.array_equal(d.qpos[controller.qa],q_actual_before)or not np.array_equal(d.qvel[controller.va],v_actual_before):
+            raise RuntimeError('Velocity FF apply modified IK seed or live joint state')
